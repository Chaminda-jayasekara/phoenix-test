# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — NEVER expose this in client code or commit it.
# Used only by lib/supabaseAdmin.js (server-side) for all the admin data reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Login password for /admin — pick your own. This is checked by a
# server action and stored in a signed, httpOnly session cookie.
ADMIN_PASSWORD=change-me

# Optional: a separate secret used to sign the session cookie. If you
# skip this, ADMIN_PASSWORD is used for signing too, which is fine for
# a single-admin site. Set this if you want to be able to rotate the
# login password without invalidating it as the signing key too.
ADMIN_SESSION_SECRET=
